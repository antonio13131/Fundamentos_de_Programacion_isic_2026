Algoritmo AltaRegistroEstudiante
    Definir numeroControl Como Entero
    Definir nombre Como Cadena
    Definir promedioPrepa Como Real
    Definir documentoscompletos Como Logico
	
    Escribir "=== ALTA DE REGISTRO DE ESTUDIANTE ==="
    Escribir ""
	
    Escribir "Ingrese Número de Control: "
    Leer numeroControl
	
    Escribir "Ingrese Nombre Completo: "
    Leer nombreCompleto
	
    Escribir "Ingrese Promedio de Preparatoria: "
    Leer promedioPrepa
	
    Escribir "¿Documentación Completa? (VERDADERO/FALSO): "
    Leer estatusDocumentos
	

    Escribir " FICHA DIGITAL DEL ESTUDIANTE" endl;
 
    Escribir "Número de Control:        ", numeroControl endl;
    Escribir "Nombre Completo:          ", nombre  endl;
    Escribir "Promedio de Preparatoria: ", promedioPrepa  endl;
    Escribir "Documentación Completa:   ", documentoscompletos  endl;

	
FinAlgoritmo